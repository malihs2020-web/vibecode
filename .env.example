VITE_GROQ_API_KEY=

# Серверные переменные для Telegram-уведомлений — задаются ТОЛЬКО
# в Vercel → Project Settings → Environment Variables (без префикса VITE_,
# чтобы не попасть в клиентский бандл). Для локальной разработки не нужны.
#
# TELEGRAM_BOT_TOKEN=        — токен бота от @BotFather
# UPSTASH_REDIS_REST_URL=    — из интеграции Upstash в Vercel Marketplace
# UPSTASH_REDIS_REST_TOKEN=
# CRON_SECRET=               — случайная строка, защищает /api/telegram/remind
